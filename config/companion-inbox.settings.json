{
  "schema_version": 1,
  "name": "codex-companion-inbox",
  "locale": "zh-CN",
  "bot_token_env": "CODEX_COMPANION_TG_BOT_TOKEN",
  "allowed_chat_id_env": "CODEX_COMPANION_TG_ALLOWED_CHAT_ID",
  "telegram_api_proxy_url_env": "CODEX_COMPANION_TG_PROXY_URL",
  "telegram_api_proxy_url": null,
  "local_config_path": "config/companion-inbox.local.json",
  "runtime_dir": "runtime/companion_inbox",
  "message_store_path": "runtime/companion_inbox/messages.json",
  "message_archive_dir": "runtime/companion_inbox/archive",
  "state_path": "runtime/companion_inbox/state.json",
  "notice_path": "runtime/companion_inbox/notice.json",
  "poll_timeout_seconds": 25,
  "idle_sleep_seconds": 2,
  "active_message_limit": 5000,
  "archive_batch_size": 1000,
  "default_window": 10,
  "max_window": 500,
  "max_message_chars": 3000,
  "attachment_download_max_bytes": 20971520,
  "outbound_attachment_max_bytes": 47185920,
  "max_media_caption_chars": 1024,
  "sticker_catalog_path": "runtime/telegram_shared/sticker_sets/catalog.json",
  "sticker_cache_dir": "runtime/telegram_shared/sticker_sets/cache",
  "max_sticker_preview_count": 24,
  "incoming_message_reaction_enabled": true,
  "incoming_message_reaction_emoji": "👌",
  "operator_ack_button_enabled": false,
  "bot_commands_enabled": true,
  "bot_commands_scope": "chat",
  "bot_commands": []
}
