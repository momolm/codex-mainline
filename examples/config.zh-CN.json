{
  "schema_version": 1,
  "name": "codex-mainline",
  "locale": "zh-CN",
  "fallback_locale": "zh-CN",
  "locales_dir": "locales",
  "codex_command": "codex",
  "app_server_endpoint": "ws://127.0.0.1:48751",
  "app_server_fallback_port_scan": 10,
  "model": "gpt-5.5",
  "service_tier": "standard",
  "effort": "xhigh",
  "sandbox_mode": "workspace-write",
  "sandbox_network_access": true,
  "sandbox_extra_writable_roots": [],
  "bot_token_env": "CODEX_MAINLINE_TG_BOT_TOKEN",
  "allowed_chat_id_env": "CODEX_MAINLINE_TG_ALLOWED_CHAT_ID",
  "telegram_api_proxy_url_env": "CODEX_MAINLINE_TG_PROXY_URL",
  "telegram_api_proxy_url": null,
  "pulse_source": "user",
  "pulse_channel": "telegram_private_chat",
  "pulse_time_zone": "Asia/Shanghai",
  "bot_commands_enabled": true,
  "bot_commands_scope": "chat",
  "bot_commands": [
    {
      "command": "status"
    },
    {
      "command": "model"
    },
    {
      "command": "effort"
    },
    {
      "command": "language"
    },
    {
      "command": "rhythm"
    },
    {
      "command": "session"
    },
    {
      "command": "history"
    },
    {
      "command": "goal"
    },
    {
      "command": "computer"
    },
    {
      "command": "stop"
    },
    {
      "command": "plan"
    }
  ],
  "local_config_path": "config/telegram.local.json",
  "state_path": "runtime/tg_mainline/state.json",
  "runtime_dir": "runtime/tg_mainline",
  "poll_timeout_seconds": 25,
  "idle_sleep_seconds": 2,
  "history_search_limit": 8,
  "media_group_collect_seconds": 2,
  "loose_media_collect_seconds": 3,
  "turn_max_wait_seconds": 2700,
  "rhythm_enabled": false,
  "rhythm_interval_seconds": 300,
  "rhythm_idle_required_seconds": 180,
  "rhythm_message_path": {
    "zh-CN": "prompts/rhythm_autonomous_action.zh-CN.md",
    "en-US": "prompts/rhythm_autonomous_action.en-US.md"
  },
  "work_budget_seconds": 1800,
  "work_budget_prompt_path": {
    "zh-CN": "prompts/work_budget_rest.zh-CN.md",
    "en-US": "prompts/work_budget_rest.en-US.md"
  },
  "rest_seconds": 600,
  "context_compaction_trigger_used_percent": 90,
  "compaction_recovery_max_attempts": 1,
  "compacting_seconds": 600,
  "compaction_recovery_pause_prompt": "【Codex Mainline】: 上下文压缩失败，当前进入压缩恢复态。请暂停一切行动：不要读取文件，不要调用工具，不要推进任务，不要展开新分析；只简短确认“已暂停，等待上下文压缩恢复”。",
  "compaction_recovery_resume_prompt": "【Codex Mainline】: Knock knock，从上下文压缩失败中恢复，压缩成功，需要继续任务。",
  "proactive_compaction_resume_prompt": "【Codex Mainline】: Knock knock，主动上下文压缩完成，需要继续压缩前的任务。",
  "compaction_input_queue_path": "runtime/tg_mainline/compaction_input_queue.jsonl",
  "compaction_replay_queue_path": "runtime/tg_mainline/compaction_replay_queue.jsonl",
  "max_message_chars": 3500,
  "startup_context_paths": [
    "docs/operator-context.example.md"
  ],
  "startup_autonomy_context_paths": []
}
