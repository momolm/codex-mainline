    "companion:self-test": "node src/start-codex-companion-inbox.mjs --self-test",
    "dry-run": "node src/start-codex-mainline.mjs --dry-run",
    "check": "node --check src/start-codex-mainline.mjs && node --check src/start-codex-companion-inbox.mjs",
    "test": "node --test src/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
