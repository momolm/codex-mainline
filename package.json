{
  "name": "codex-mainline",
  "version": "0.1.15",
  "private": false,
  "type": "module",
  "license": "MIT",
  "bin": {
    "codex-mainline": "./src/start-codex-mainline.mjs"
  },
  "scripts": {
    "start": "node src/start-codex-mainline.mjs",
    "companion": "node src/start-codex-companion-inbox.mjs",
